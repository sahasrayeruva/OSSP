#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/stat.h>

#define FIFO1 "client_to_server"
#define FIFO2 "server_to_client"

int main()
{
    char message[100];
    char response[100];

    mkfifo(FIFO1, 0666);
    mkfifo(FIFO2, 0666);

    printf("Server started. Waiting for client...\n");

    int read_fd = open(FIFO1, O_RDONLY);
    int write_fd = open(FIFO2, O_WRONLY);

    while (1)
    {
        read(read_fd, message, sizeof(message));

        if (strcmp(message, "exit") == 0)
            break;

        printf("Client: %s\n", message);

        sprintf(response, "Server received: %s", message);

        write(write_fd, response, strlen(response) + 1);
    }

    close(read_fd);
    close(write_fd);

    unlink(FIFO1);
    unlink(FIFO2);

    return 0;
}
