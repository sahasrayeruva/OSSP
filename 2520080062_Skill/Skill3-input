#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define INITIAL_SIZE 5
#define BUFFER_SIZE 100

int main() {
    char **history;
    int capacity = INITIAL_SIZE;
    int count = 0;
    char buffer[BUFFER_SIZE];

    history = malloc(capacity * sizeof(char *));

    if (history == NULL) {
        printf("Memory allocation failed\n");
        return 1;
    }

    printf("Simple Shell with Command History\n");
    printf("Type 'exit' to quit\n");

    while (1) {
        printf("$ ");
        fgets(buffer, BUFFER_SIZE, stdin);

        buffer[strcspn(buffer, "\n")] = '\0';

        if (strcmp(buffer, "exit") == 0)
            break;

        if (count == capacity) {
            capacity *= 2;
            history = realloc(history, capacity * sizeof(char *));

            if (history == NULL) {
                printf("Memory allocation failed\n");
                return 1;
            }
        }

        history[count] = malloc(strlen(buffer) + 1);
        strcpy(history[count], buffer);
        count++;

        printf("Command stored: %s\n", buffer);
    }

    printf("\nCommand History:\n");

    for (int i = 0; i < count; i++) {
        printf("%d. %s\n", i + 1, history[i]);
        free(history[i]);
    }

    free(history);

    return 0;
}
